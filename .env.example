# Database (Railway auto-sets this)
DATABASE_URL=postgresql://user:pass@localhost:5432/mindcare

# JWT Secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your-jwt-secret-here

# Twilio Verify (optional — without VERIFY_SERVICE_SID the app uses demo OTP)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_VERIFY_SERVICE_SID=your-verify-service-sid

# Demo mode (set true to bypass OTP for judges)
DEMO_MODE=true
DEMO_PHONE=+910000000000

# Cloud speech-to-text — OFF by default (use Sherpa on phone / Web Speech + chips on PWA)
# SPEECH_PROVIDER=off
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Server
PORT=3000
