{
  "expo": {
    "name": "DementiaSupport",
    "slug": "dementiasupport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dementiasupport",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dementiasupport.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "DementiaSupport listens so the patient can answer by voice.",
        "NSPhotoLibraryUsageDescription": "Caregivers add family memory photos for personalized sessions.",
        "NSSpeechRecognitionUsageDescription": "Voice answers are used only for cognitive session scoring on this device."
      }
    },
    "android": {
      "package": "com.dementiasupport.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8E2D4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3EFE6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DementiaSupport to access photos for family memory games."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_DEMO_MODE": "true",
      "EXPO_PUBLIC_SUPABASE_URL": "",
      "EXPO_PUBLIC_SUPABASE_ANON_KEY": ""
    }
  }
}
